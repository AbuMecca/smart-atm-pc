# --- Database -------------------------------------------------------------
# atm.db is generated by `python seed.py`, so it is not source code.
# Keeping it out of git also means nobody clones a copy of the PINs.
atm.db
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Machine-specific local files ----------------------------------------
# Local tool settings and the PATH backup are specific to one PC.
.claude/settings.local.json
.claude/user-path-backup.txt
